# 1. Create an array (list)
numbers = [10, 20, 30, 40]
fruits = ["apple", "banana", "mango"]

# 2. Access elements (indexing starts at 0)
print(numbers[0])   # Output: 10 (first item)
print(fruits[1])    # Output: banana (second item)

# 3. Add a new item
numbers.append(50)
print(numbers)      # Output: [10, 20, 30, 40, 50]

# 4. Update an item
numbers[1] = 25
print(numbers)      # Output: [10, 25, 30, 40, 50]

# 5. Remove an item
numbers.remove(30)
print(numbers)      # Output: [10, 25, 40, 50]
